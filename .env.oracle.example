# Copy to .env.oracle on the Oracle VM. Never commit the real file.
DOMAIN=api.example.com
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=api.example.com

# Android Capacitor uses https://localhost as its app origin.
CORS_ALLOWED_ORIGINS=https://localhost,http://localhost

POSTGRES_DB=hrms
POSTGRES_USER=hrms_user
POSTGRES_PASSWORD=replace-with-a-long-unique-password
DATABASE_URL=postgresql://hrms_user:replace-with-the-same-password@db:5432/hrms

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
MEDIA_ROOT=media
MEDIA_URL=/media/
MAX_UPLOAD_SIZE_MB=10
AUDIT_LOG_ENABLED=True
RATE_LIMIT_AUTH_PER_MINUTE=10
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN
