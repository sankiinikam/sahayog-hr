# Django
SECRET_KEY=your-secret-key-here-generate-with-django-get-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://hrms_user:your_password@localhost:5432/hrms_dev

# CORS — add desktop (electron) and mobile dev origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True

# Email (configure for password reset)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=your-email-password

# File storage
MEDIA_ROOT=media
MEDIA_URL=/media/
MAX_UPLOAD_SIZE_MB=10

# Audit
AUDIT_LOG_ENABLED=True

# Rate limiting
RATE_LIMIT_AUTH_PER_MINUTE=10

# Company defaults (can be overridden per company)
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN

# Production only — leave blank for development
SENTRY_DSN=

