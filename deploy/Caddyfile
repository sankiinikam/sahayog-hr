    encode zstd gzip

    handle /api/* {
        reverse_proxy api:8000
    }
    handle /admin/* {
        reverse_proxy api:8000
    }
    handle /static/* {
        reverse_proxy api:8000
    }
    handle /media/* {
        reverse_proxy api:8000
    }

    handle {
