{$DOMAIN} {
    encode zstd gzip

    # Proxy Django API, Admin, Static, and Media to backend
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /admin/* {
        reverse_proxy api:8000
    }
    handle /static/* {
        reverse_proxy api:8000
    }
    handle /media/* {
        reverse_proxy api:8000
    }

    # Serve React Single Page Application for all web routes
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
